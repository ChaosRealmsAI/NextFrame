{
  "id": "poster-import-roundtrip",
  "feature": "v022-poster-pipeline",
  "given": "tmp/v021-explain 已有 7 张图 + 7 段 mp3 + 7 timeline + batch.json",
  "when": "跑 nf poster-import tmp/v021-explain --out=examples/v021-explain · 然后 nf open + nf export",
  "then": "examples/v021-explain composition validate 通过 · 桌面播放看到图+听音+字幕 · nf export 出 mp4 文件 > 1MB",
  "human_actions": [
    "扫描 tmp/v021-explain 目录 · 解析 batch.json + timeline · 累计 audio duration_ms 算 anchor",
    "拼 composition.json (7 image-slide tracks + 7 audio tracks + 7 subtitle tracks · anchor 命名 slide-1..slide-7)",
    "复制 PNG/MP3/timeline.json 到 examples/v021-explain/{components,audio}",
    "nf composition validate 跑通 · 0 error 0 critical",
    "nf open + nf capture 截图证据 · 看到第 1 张图渲染",
    "nf export → mp4 文件落盘 + 大小 > 1MB"
  ],
  "ai_tools": [
    {
      "tool": "nf-poster-import",
      "command": "target/debug/nf poster-import tmp/v021-explain --out=v021-explain",
      "expect_exit": 0,
      "expect_stdout_contains": null,
      "asserts": [
        "stdout-json:.slides=7",
        "stdout-json:.tracks=21",
        "file-exists:examples/v021-explain/compositions/main.json"
      ]
    },
    {
      "tool": "nf-composition-validate",
      "command": "target/debug/nf composition validate --project=v021-explain --composition=main",
      "expect_exit": 0,
      "expect_stdout_contains": null,
      "asserts": [
        "stdout-json:.ok=true"
      ]
    },
    {
      "tool": "nf-shell-startup",
      "command": "pkill -f 'target/debug/nf-shell' 2>/dev/null; sleep 1; (target/debug/nf-shell > /tmp/shell-bdd.log 2>&1 &) && sleep 4 && head -1 /tmp/shell-bdd.log",
      "expect_exit": 0,
      "expect_stdout_contains": null,
      "asserts": [
        "stdout-contains:\"event\":\"ready\""
      ]
    },
    {
      "tool": "nf-open",
      "command": "target/debug/nf open --project=v021-explain --composition=main --episode=main && sleep 3",
      "expect_exit": 0,
      "expect_stdout_contains": null,
      "asserts": [
        "stdout-json:.window_id=w-1"
      ]
    },
    {
      "tool": "nf-capture",
      "command": "target/debug/nf capture --project=v021-explain --episode=main --out=spec/versions/v0.22.0/evidence/desktop.png",
      "expect_exit": 0,
      "expect_stdout_contains": null,
      "asserts": [
        "file-min-bytes:spec/versions/v0.22.0/evidence/desktop.png:500000"
      ]
    },
    {
      "tool": "nf-export",
      "command": "target/debug/nf export --project=v021-explain --composition=main --profile=draft --out=spec/versions/v0.22.0/evidence/v021-explain.mp4",
      "expect_exit": 0,
      "expect_stdout_contains": null,
      "asserts": [
        "stdout-json:.audio_muxed=true",
        "file-min-bytes:spec/versions/v0.22.0/evidence/v021-explain.mp4:5000000"
      ]
    },
    {
      "tool": "nf-frame-extract",
      "command": "ffmpeg -y -ss 5 -i spec/versions/v0.22.0/evidence/v021-explain.mp4 -vframes 1 spec/versions/v0.22.0/evidence/frame-5s.png 2>&1 | tail -1; ls -la spec/versions/v0.22.0/evidence/frame-5s.png",
      "expect_exit": 0,
      "expect_stdout_contains": null,
      "asserts": [
        "file-min-bytes:spec/versions/v0.22.0/evidence/frame-5s.png:200000"
      ]
    },
    {
      "tool": "nf-shell-quit",
      "command": "target/debug/nf quit 2>&1 || true",
      "expect_exit": 0,
      "expect_stdout_contains": null,
      "asserts": [
        "stdout-contains:quit"
      ]
    }
  ],
  "demo": "demos/poster-import-roundtrip.html",
  "status": "done",
