    {"tool": "transcribe-fallback", "command": "nf-source transcribe --transcript tests/fixtures/clips/demo.srt --out output/transcript.srt", "output": "exit 0 + output/transcript.srt"},
    {"tool": "verify-srt", "command": "wc -l output/transcript.srt", "output": "数字 · 期望 >= 5"}
  ],

