{
  "kind": "bg",
  "name": "Background Track",
  "description": "背景轨道 · 纯色 / 渐变 / 图片 / 视频 · 全屏铺底 · 任何开场",
  "use_cases": ["品牌背景", "氛围铺底", "过场"],
  "t0_visibility": 1.0,
  "z_order_hint": 0,
  "visual_channels": ["scene"],

  "params": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Track.bg params · discriminated union by 'type'",
    "type": "object",
    "required": ["type"],
    "oneOf": [
      {
        "title": "solid",
        "type": "object",
        "required": ["type", "color"],
        "additionalProperties": false,
        "properties": {
          "type": {"const": "solid"},
          "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
        }
      },
      {
        "title": "gradient",
        "type": "object",
        "required": ["type", "gradient", "stops"],
        "additionalProperties": false,
        "properties": {
          "type": {"const": "gradient"},
          "gradient": {"enum": ["linear", "radial", "conic"]},
          "angle": {"type": "number", "minimum": 0, "maximum": 360},
          "stops": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["offset", "color"],
              "additionalProperties": false,
              "properties": {
                "offset": {"type": "number", "minimum": 0, "maximum": 1},
                "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6,8}$"}
              }
            }
          }
        }
      },
      {
        "title": "image",
        "type": "object",
        "required": ["type", "src"],
        "additionalProperties": false,
        "properties": {
          "type": {"const": "image"},
          "src": {"type": "string", "pattern": "^(file://|data:|https?://)"},
          "fit": {"type": "string", "enum": ["cover", "contain", "fill"], "default": "cover"}
        }
      },
      {
        "title": "video",
        "type": "object",
        "required": ["type", "src"],
        "additionalProperties": false,
        "properties": {
          "type": {"const": "video"},
          "src": {"type": "string", "pattern": "^(file://|data:|https?://)"},
          "from_ms": {"type": "number", "minimum": 0},
          "to_ms": {"type": "number", "minimum": 0},
          "fit": {"type": "string", "enum": ["cover", "contain", "fill"], "default": "cover"},
          "muted_in_record": {"const": true}
        }
      }
    ]
  },

  "sample": {
    "type": "gradient",
    "gradient": "linear",
    "angle": 135,
    "stops": [
      {"offset": 0, "color": "#0f172a"},
      {"offset": 1, "color": "#1e1b4b"}
    ]
  }
}
