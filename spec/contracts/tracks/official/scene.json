{
  "kind": "scene",
  "name": "Scene Track",
  "description": "场景轨道 · 基础 layout(hero / stat)· 大标题 / 关键数据 / 章节过渡",
  "use_cases": ["开场介绍", "关键数据", "章节过渡"],
  "t0_visibility": 0.95,
  "z_order_hint": 3,
  "visual_channels": ["scene"],
  "duration_hint_ms": 3000,

  "params": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["layout"],
    "additionalProperties": false,
    "properties": {
      "layout": {"type": "string", "enum": ["hero", "stat"]},
      "title": {"type": "string", "maxLength": 200},
      "subtitle": {"type": "string", "maxLength": 200},
      "big_number": {"type": "string", "maxLength": 32},
      "label": {"type": "string", "maxLength": 200},
      "sublabel": {"type": "string", "maxLength": 200},
      "accent_color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
      "bg_color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
    }
  },

  "sample": {
    "layout": "hero",
    "title": "NextFrame",
    "subtitle": "AI 视频引擎 · v0.8",
    "accent_color": "#bc8cff"
  }
}
