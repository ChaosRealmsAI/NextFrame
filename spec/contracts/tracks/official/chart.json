{
  "kind": "chart",
  "name": "Chart Track",
  "description": "数据图表轨道 · 柱状 / 折线 / 饼图 · 数据驱动入场 · 财报 / 数据汇报",
  "use_cases": ["月度财报", "数据报告", "KPI 展示"],
  "t0_visibility": 0.95,
  "z_order_hint": 3,
  "visual_channels": ["scene"],

  "params": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["chart_type", "series"],
    "additionalProperties": false,
    "properties": {
      "chart_type": {"type": "string", "enum": ["bar", "line", "pie"]},
      "layout": {"type": "string", "enum": ["grouped", "stacked", "default"], "default": "grouped"},
      "title": {"type": "string", "maxLength": 200},
      "categories": {
        "type": "array",
        "items": {"type": "string", "maxLength": 50},
        "maxItems": 20,
        "description": "X 轴类别(bar/line 必需)· pie 忽略用 series[i].name"
      },
      "series": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string", "maxLength": 50},
            "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
            "data": {
              "type": "array",
              "items": {"type": "number"},
              "description": "bar/line 用 · 长度 = categories.length"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "description": "pie 单系列数值 · 自动归一化"
            }
          }
        }
      },
      "animation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "duration_ms": {"type": "number", "minimum": 0, "maximum": 5000},
          "stagger_ms": {"type": "number", "minimum": 0, "maximum": 500},
          "mode": {"type": "string", "enum": ["rise", "fade", "sweep"]}
        }
      }
    }
  },

  "sample": {
    "chart_type": "bar",
    "layout": "grouped",
    "categories": ["Q1", "Q2", "Q3", "Q4"],
    "series": [
      {"name": "2024", "color": "#a78bfa", "data": [45, 55, 50, 62]},
      {"name": "2025", "color": "#f97316", "data": [58, 68, 65, 78]},
      {"name": "2026", "color": "#34d399", "data": [72, 82, 88, 95]}
    ],
    "animation": {"duration_ms": 1500, "stagger_ms": 80, "mode": "rise"},
    "title": "季度销售额(万元)"
  }
}
