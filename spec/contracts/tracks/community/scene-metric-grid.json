{
  "kind": "scene-metric-grid",
  "category": "community",
  "level": 1,
  "name": "Metric Grid",
  "description": "2-4 指标宫格 · 每 cell 数字 + label + unit · 响应式(2=1x2 / 3=1x3 / 4=2x2)· stagger 入场 100ms · 季度财报 / 月报 / OKR",
  "use_cases": ["季度财报", "多指标汇总", "月度对比"],
  "t0_visibility": 0.95,
  "z_order_hint": 3,
  "visual_channels": ["scene"],
  "duration_hint_ms": 3000,

  "src_hint": "frontend/nf-tracks/community/scene-metric-grid.js",

  "params": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["items"],
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "items": {
          "type": "object",
          "required": ["label", "value"],
          "additionalProperties": false,
          "properties": {
            "label": {"type": "string", "maxLength": 40},
            "value": {"type": ["number", "string"]},
            "unit": {"type": "string", "maxLength": 8}
          }
        }
      },
      "accent_color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#a78bfa"}
    }
  },

  "sample": {
    "items": [
      {"label": "月活用户", "value": 142, "unit": "K"},
      {"label": "营收", "value": 38.6, "unit": "M"},
      {"label": "留存率", "value": 67, "unit": "%"},
      {"label": "NPS", "value": 52}
    ],
    "accent_color": "#a78bfa"
  }
}
