{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nextframe.dev/spec/timeline-v08",
  "title": "NextFrame Timeline v0.8",
  "description": "轨道承载一切 · 承接 v1.26 结构 · scope v0.8.0 = schema 4 kind 全列 + scene track 实现",

  "type": "object",
  "required": ["meta", "viewport", "duration", "anchors", "tracks"],
  "additionalProperties": false,

  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "maxLength": 200},
        "description": {"type": "string"},
        "version": {"type": "string", "const": "v0.8"},
        "created": {"type": "string", "format": "date"}
      }
    },

    "viewport": {
      "type": "object",
      "required": ["ratio", "w", "h"],
      "properties": {
        "ratio": {"type": "string", "enum": ["16:9", "9:16", "1:1", "4:3"]},
        "w": {"type": "integer", "minimum": 320},
        "h": {"type": "integer", "minimum": 320}
      }
    },

    "duration": {
      "description": "时长 = 某锚点名(如 'demo.end')",
      "type": "string",
      "pattern": "^[a-zA-Z][\\w-]*\\.(begin|end)$"
    },

    "anchors": {
      "description": "锚点表 · key = 锚点名 · value = 形态 A(数字字符串绝对 ms) / B(对象 {begin, end, filler})",
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z][\\w-]*$": {
          "oneOf": [
            {
              "description": "形态 A · 绝对 ms · 例 '0' 或 '1500'",
              "type": "string",
              "pattern": "^\\d+$"
            },
            {
              "description": "形态 B · 命名段 · begin/end 引用别 anchor 或绝对 ms · filler 标记来源",
              "type": "object",
              "required": ["begin", "end"],
              "additionalProperties": false,
              "properties": {
                "begin": {"$ref": "#/definitions/anchorRef"},
                "end": {"$ref": "#/definitions/anchorRef"},
                "filler": {"type": "string", "enum": ["manual", "whisper"]}
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },

    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/track"}
    }
  },

  "definitions": {
    "anchorRef": {
      "description": "anchor 引用 · 绝对 ms 字符串 / '锚点名.begin' / '锚点名.end' · v0.8 最小闭环不支持 '+30s' 表达式(下版加)",
      "type": "string",
      "pattern": "^(\\d+|[a-zA-Z][\\w-]*\\.(begin|end))$"
    },

    "track": {
      "type": "object",
      "required": ["id", "kind", "clips"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z][\\w-]*$"},
        "kind": {
          "description": "开放字符串 · 8 官方 kind(scene/audio/subtitle/animation/bg/video/chart/data)或 community kind(如 scene-hero-centered · scene-quote · webgl-particles)· community kind 必须提供 src 字段",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "src": {
          "description": "实现路径 · official kind 可省略(走默认 frontend/nf-tracks/official/{kind}.js)· community kind 必须显式指定",
          "type": "string"
        },
        "clips": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/clip"}
        }
      }
    },

    "clip": {
      "type": "object",
      "required": ["id", "begin", "end"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z][\\w-]*$"},
        "begin": {"$ref": "#/definitions/anchorRef"},
        "end": {"$ref": "#/definitions/anchorRef"},
        "params": {
          "description": "kind-specific params · 按 Track 的 describe().params JSON schema 自校验",
          "type": "object"
        }
      }
    }
  }
}
