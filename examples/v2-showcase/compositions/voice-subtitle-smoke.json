{
  "schema": "nextframe.composition.v2",
  "id": "voice-subtitle-smoke",
  "name": "Voice Subtitle Smoke",
  "duration": "4s",
  "viewport": { "w": 1920, "h": 1080, "ratio": "16:9" },
  "theme": "launch.dark",
  "export": { "resolution": "720p" },
  "anchors": {
    "intro": "0s",
    "out": "4s"
  },
  "tracks": [
    {
      "id": "stage-bg",
      "kind": "component",
