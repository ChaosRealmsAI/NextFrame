{
  "schema": "nextframe.composition.v3",
  "id": "showreel-clip-first",
  "name": "Clip First Authoring",
  "viewport": { "w": 1920, "h": 1080, "ratio": "16:9" },
  "theme": "launch.dark",
  "export": { "resolution": "1080p" },
  "clips": [
    {
      "id": "intro",
      "name": "Intro",
      "duration": "5.2s",
      "anchors": {
        "title-in": "0.4s",
        "voice-out": "out"
      },
      "tracks": [
        {
          "id": "stage",
          "kind": "component",
          "component": "html.stage-background",
          "z": 0,
          "items": [
            {
              "id": "bg",
              "time": { "start": "in", "end": "out" },
              "params": { "pulse": 0.72 }
            }
          ]
        },
        {
          "id": "title",
          "kind": "component",
          "component": "html.sequence-title",
          "z": 30,
          "items": [
            {
              "id": "headline",
              "time": { "start": "title-in", "end": "out" },
              "params": {
                "eyebrow": "CLIP FIRST",
                "title": "AI writes one video segment at a time",
                "subtitle": "Each clip owns its anchors, tracks, TTS and subtitles.",
                "x": 48,
                "y": 44,
                "align": "left"
              }
            }
          ]
        },
        {
          "id": "voice",
          "kind": "tts",
          "z": 10,
          "timeline": "audio/intro-main.timeline.json",
          "tts": {
            "backend": "nftts",
            "voice": "alloy",
            "text": "A clip is one video segment."
          },
          "items": [
            {
              "id": "main",
              "time": { "start": "in", "end": "voice-out" },
              "audio": "data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAESsAACJWAAACABAAZGF0YQAAAAA=",
              "volume": 1
            }
          ]
        },
        {
          "id": "subtitle-words",
          "kind": "subtitle_timeline",
          "source": "voice",
          "timeline": "audio/intro-main.timeline.json"
        },
        {
          "id": "subtitles",
          "kind": "subtitle",
          "z": 80,
          "source": "subtitle-words",
          "style": {
            "active_color": "#ffca66",
            "color": "#ffffff",
            "size_px": 34,
            "position": "bottom",
            "padding": 62
          },
          "items": [
            { "id": "karaoke", "time": { "start": "in", "end": "out" } }
          ]
        }
      ]
    },
    {
      "id": "proof",
      "name": "Local Tracks",
      "duration": "6.2s",
      "anchors": {
        "panel-in": "0.5s",
        "panel-out": "out"
      },
      "tracks": [
        {
          "id": "stage",
          "kind": "component",
          "component": "canvas.particle-field",
          "z": 4,
          "items": [
            { "id": "particles", "time": { "start": "in", "end": "out" }, "params": { "density": 60, "energy": 0.82 } }
          ]
        },
        {
          "id": "stack",
          "kind": "component",
          "component": "html.layer-stack",
          "z": 34,
          "items": [
            {
              "id": "tracks",
              "time": { "start": "panel-in", "end": "panel-out" },
              "params": {
                "x": 52,
                "y": 52,
                "layers": ["clip.anchors", "track: component", "track: tts", "track: subtitle_timeline", "track: subtitle"]
              }
            }
          ]
        },
        {
          "id": "voice",
          "kind": "tts",
          "timeline": "audio/proof-main.timeline.json",
          "tts": { "backend": "nftts", "voice": "alloy", "text": "Inside that clip tracks stay local." },
          "items": [
            {
              "id": "main",
              "time": { "start": "in", "end": "out" },
              "audio": "data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAESsAACJWAAACABAAZGF0YQAAAAA="
            }
          ]
        },
        { "id": "subtitle-words", "kind": "subtitle_timeline", "timeline": "audio/proof-main.timeline.json" },
        {
          "id": "subtitles",
          "kind": "subtitle",
          "z": 80,
          "source": "subtitle-words",
          "items": [
            { "id": "karaoke", "time": { "start": "in", "end": "out" } }
          ]
        }
      ]
    },
    {
      "id": "outro",
      "name": "Voice Timeline",
      "duration": "5s",
      "tracks": [
        {
          "id": "title",
          "kind": "component",
          "component": "html.sequence-title",
          "z": 38,
          "items": [
            {
              "id": "final",
              "time": { "start": "in", "end": "out" },
              "params": {
                "eyebrow": "NFTTS TIMELINE",
                "title": "Subtitles reuse the TTS timeline",
                "subtitle": "The clip does not invent another word timeline.",
                "x": 50,
                "y": 44,
                "align": "center"
              }
            }
          ]
        },
        {
          "id": "voice",
          "kind": "tts",
          "timeline": "audio/outro-main.timeline.json",
          "tts": { "backend": "nftts", "voice": "alloy", "text": "Voice creates the subtitle timeline." },
          "items": [
            {
              "id": "main",
              "time": { "start": "in", "end": "out" },
              "audio": "data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAESsAACJWAAACABAAZGF0YQAAAAA="
            }
          ]
        },
        { "id": "subtitle-words", "kind": "subtitle_timeline", "timeline": "audio/outro-main.timeline.json" },
        {
          "id": "subtitles",
          "kind": "subtitle",
          "z": 80,
          "source": "subtitle-words",
          "items": [
            { "id": "karaoke", "time": { "start": "in", "end": "out" } }
          ]
        }
      ]
    }
  ]
}
