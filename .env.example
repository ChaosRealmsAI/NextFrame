# NextFrame · v0.1.7 POC · 硅基流动 API 配置
#
# 使用步骤:
#   1. cp .env.example .env
#   2. 申请硅基流动 key: https://cloud.siliconflow.cn/account/ak
#      (新用户有免费额度 · 国内直连 · 人民币发票)
#   3. 填下面的 SILICONFLOW_API_KEY
#   4. 跑: bash scripts/siliconflow-probe.sh "你好"
#
# 铁律:
#   - .env 已在 .gitignore · 禁 commit
#   - key 以 sk- 开头 · 泄漏请立即去硅基控制台 revoke 重发
#   - 不要粘贴到任何聊天 / issue / screenshot

# ============ 硅基流动 ============

# 必填 · 你的硅基流动 API key
SILICONFLOW_API_KEY=sk-your-key-here

# 可选 · 默认模型(硅基免费 + 中文母语的首选)
# 候选:deepseek-ai/DeepSeek-V3 / Qwen/Qwen3-8B / Qwen/Qwen2.5-7B-Instruct / THUDM/GLM-4-9B-Chat
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# 可选 · API base URL(OpenAI compat)· 默认官方
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
