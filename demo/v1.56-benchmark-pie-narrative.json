{
  "$schema": "../spec/schema/source.schema.json",
  "meta": {
    "title": "v1.56 benchmark · pie + narrative",
    "version": "v1.56.0"
  },
  "viewport": { "ratio": "16:9", "w": 1920, "h": 1080 },
  "duration": "demo.end",
  "anchors": {
    "demo": { "begin": "0", "end": "demo.begin + 10s" }
  },
  "tracks": [
    {
      "id": "bg",
      "kind": "bg",
      "src": "src/nf-tracks/official/bg.js",
