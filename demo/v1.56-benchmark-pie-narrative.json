        {
          "id": "quote-main",
          "begin": "demo.begin",
          "end": "demo.end",
          "params": {
            "quote": "好的工具不是让你做更多事 · 是让你少做不该做的事",
            "author": "Claude",
            "title": "AI 协作者",
            "accent_color": "#a78bfa"
          }
        }
      ]
    },
    {
      "id": "list-feature",
      "kind": "scene-list-bullets",
      "src": "src/nf-tracks/community/scene-list-bullets.js",
      "clips": [
        {
          "id": "list-main",
          "begin": "demo.begin",
          "end": "demo.end",
