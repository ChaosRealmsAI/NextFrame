        {
          "id": "chart-pie-main",
          "begin": "demo.begin",
          "end": "demo.end",
          "params": {
            "chart_type": "pie",
            "series": [
              { "name": "移动端", "value": 52, "color": "#a78bfa" },
              { "name": "桌面端", "value": 28, "color": "#34d399" },
