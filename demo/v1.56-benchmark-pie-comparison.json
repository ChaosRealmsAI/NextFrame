{
  "$schema": "../spec/schema/source.schema.json",
  "meta": {
    "title": "v1.56 benchmark · pie + comparison",
    "version": "v1.56.0"
  },
  "viewport": { "ratio": "16:9", "w": 1920, "h": 1080 },
  "duration": "demo.end",
  "anchors": {
    "demo": { "begin": "0", "end": "demo.begin + 10s" }
  },
  "tracks": [
    {
      "id": "bg",
      "kind": "bg",
      "src": "src/nf-tracks/official/bg.js",
      "clips": [
        {
          "id": "bg-main",
          "begin": "demo.begin",
          "end": "demo.end",
          "params": {
            "type": "solid",
            "color": "#0a0a14"
          }
        }
      ]
    },
    {
      "id": "chart-pie",
      "kind": "chart",
      "src": "src/nf-tracks/official/chart.js",
      "clips": [
        {
          "id": "chart-pie-main",
          "begin": "demo.begin",
          "end": "demo.end",
          "params": {
            "chart_type": "pie",
            "series": [
              { "name": "移动端", "value": 52, "color": "#a78bfa" },
              { "name": "桌面端", "value": 28, "color": "#34d399" },
              { "name": "平板", "value": 10, "color": "#38bdf8" },
              { "name": "电视", "value": 6, "color": "#f59e0b" },
              { "name": "其他", "value": 4, "color": "#f87171" }
            ],
            "animation": { "duration_ms": 1200, "stagger_ms": 90, "mode": "sweep" },
            "title": "2026 Q3 终端占比"
          }
        }
      ]
    },
    {
      "id": "data-compare",
      "kind": "data",
      "src": "src/nf-tracks/official/data.js",
      "clips": [
        {
          "id": "data-compare-main",
          "begin": "demo.begin",
          "end": "demo.end",
          "params": {
            "type": "comparison",
            "title": "Export Strategy",
            "options": [
              { "key": "serial", "label": "Serial" },
              { "key": "p2", "label": "Parallel 2" },
              { "key": "p4", "label": "Parallel 4" }
            ],
            "criteria": [
              {
                "label": "Wall Time",
                "values": { "serial": 1.0, "p2": 0.58, "p4": 0.36 },
                "winner_key": "p4"
              },
              {
                "label": "PTS Match",
                "values": { "serial": true, "p2": true, "p4": true }
              },
              {
                "label": "Framemd5",
                "values": { "serial": true, "p2": true, "p4": true }
              },
              {
                "label": "Re-encode",
                "values": { "serial": false, "p2": false, "p4": false }
              },
              {
                "label": "Default 4K",
                "values": { "serial": "manual", "p2": "manual", "p4": "auto" },
                "winner_key": "p4"
              }
            ],
            "stagger_ms": 90,
            "interpolate_ms": 500
          }
        }
      ]
    }
  ]
}
