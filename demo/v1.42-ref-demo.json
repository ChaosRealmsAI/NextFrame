{
  "$schema": "../spec/schema/source.schema.json",
  "meta": {
    "title": "v1.42 · source.json v2 · data/theme/$ref demo",
    "description": "config DRY · top-level data + {$ref:'#/data/x'} in clip params",
    "version": "v1.42.0"
  },
  "viewport": { "ratio": "16:9", "w": 1920, "h": 1080 },
  "duration": "demo.end",
  "anchors": {
    "demo": { "begin": "0", "end": "demo.begin + 10s" }
  },
  "data": {
    "product": "NextFrame",
    "subtitle": "AI 视频引擎 · v1.42 · {$ref} resolver 落地",
    "price": 299,
    "accent": "#a78bfa"
  },
  "theme": {
    "bg_start": "#1e1b4b",
    "bg_end": "#4c1d95"
  },
  "tracks": [
    {
      "id": "bg-gradient",
      "kind": "bg",
      "src": "src/nf-tracks/official/bg.js",
      "clips": [
        {
          "id": "bg-all",
          "begin": "demo.begin",
          "end": "demo.end",
          "params": {
            "type": "gradient",
            "gradient": "radial",
            "stops": [
              { "offset": 0, "color": { "$ref": "#/theme/bg_end" } },
              { "offset": 1, "color": { "$ref": "#/theme/bg_start" } }
            ]
          }
        }
      ]
    },
    {
      "id": "hero-title",
      "kind": "scene",
      "src": "src/nf-tracks/official/scene.js",
      "clips": [
        {
          "id": "title-main",
          "begin": "demo.begin",
          "end": "demo.end",
          "params": {
            "layout": "hero",
            "title": { "$ref": "#/data/product" },
            "subtitle": { "$ref": "#/data/subtitle" },
            "accent_color": { "$ref": "#/data/accent" }
          }
        }
      ]
    }
  ]
}
